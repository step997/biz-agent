# 大模型（可选；留空则走 offline 规则引擎，功能完整可演示）
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# llm | offline；留空 = 有 key 走 llm，无 key 自动 offline
AGENT_MODE=

# 业务系统（mock ERP）
BIZ_BASE_URL=http://127.0.0.1:8001
BIZ_API_KEY=demo-key

# 检索后端：auto | tfidf | embedding | hybrid
# auto = 装得起语义依赖就走 hybrid，否则 tfidf（pytest 固定 tfidf 保证确定性）
RAG_BACKEND=auto
# 语义模型（首次运行需联网下载，或预先跑 scripts/build_embeddings.py）
EMB_MODEL=BAAI/bge-small-zh-v1.5
# 1 = 用 faiss 内积索引；0 = numpy 点积（两者结果一致，faiss 便于扩到万级语料）
RAG_USE_FAISS=1
# 国内网络建议走镜像；模型已缓存后可设 HF_HUB_OFFLINE=1 免联网检查
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=

# 巡检推送（可选；留空只打印到控制台并写审计库）
WECOM_WEBHOOK=
PATROL_CRON_HOUR=8
PATROL_CRON_MINUTE=0

# 时区（容器里建议 Asia/Shanghai）
TZ=Asia/Shanghai
